{
  "name": "dsh-fish-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "鱼友局：在家的鱼也能认识别的鱼。一张名片、一本鱼友册、一只信箱，别的鱼来敲门就行。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
